<mxfile host="app.diagrams.net" modified="2026-11-10T20:55:00.000Z" agent="SIGEC Diagram Generator" version="24.0.0" type="device">
  <diagram id="1._hardware_e_conexoes" name="1. Hardware e Conexoes">
    <mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="&lt;b style='font-size: 20px;'&gt;SIGEC — Esquema Completo de Ligações e Pinagem (ESP32)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 13px; color: #555555;'&gt;Detalhamento Fio a Fio: Divisor VBIAS, SCT-013, SCD40 (I2C), LED IR e Sinalização&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;">
          <mxGeometry x="380" y="20" width="640" height="50" as="geometry" />
        </mxCell>
        <mxCell id="esp32" parent="1" vertex="1" value="&lt;div style='font-size: 13px; font-weight: bold; padding: 4px;'&gt;ESP32 DevKit v1&lt;/div&gt;&lt;span style='font-size: 10px; color: #BDC3C7;'&gt;SoC Wi-Fi 2.4GHz + Dual-Core 240MHz&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;table style='font-size: 10px; width: 100%; border-collapse: collapse; text-align: left; padding: 2px;'&gt;&lt;tr style='border-bottom: 1px solid #444;'&gt;&lt;th style='color: #F1C40F;'&gt;Lado Esquerdo&lt;/th&gt;&lt;th style='text-align: right; color: #2ECC71;'&gt;Lado Direito&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='color: #888;'&gt;EN&lt;/td&gt;&lt;td style='text-align: right; color: #888;'&gt;GPIO 23&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='color: #888;'&gt;VP (GPIO 36)&lt;/td&gt;&lt;td style='text-align: right; color: #2ECC71; font-weight: bold;'&gt;GPIO 22 (SCL) •&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='color: #888;'&gt;VN (GPIO 39)&lt;/td&gt;&lt;td style='text-align: right; color: #888;'&gt;TX0 / RX0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='color: #F1C40F; font-weight: bold;'&gt;• GPIO 34 (ADC1)&lt;/td&gt;&lt;td style='text-align: right; color: #2ECC71; font-weight: bold;'&gt;GPIO 21 (SDA) •&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='color: #888;'&gt;GPIO 35 .. 12&lt;/td&gt;&lt;td style='text-align: right; color: #888;'&gt;GPIO 19&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='color: #E67E22; font-weight: bold;'&gt;• 3V3 (Saída 3.3V)&lt;/td&gt;&lt;td style='text-align: right; color: #F39C12; font-weight: bold;'&gt;GPIO 18 (Heartbeat) •&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='color: #BDC3C7; font-weight: bold;'&gt;• GND (Terra)&lt;/td&gt;&lt;td style='text-align: right; color: #9B59B6; font-weight: bold;'&gt;GPIO 4 (LED IR) •&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='color: #E74C3C;'&gt;• VIN (USB 5V)&lt;/td&gt;&lt;td style='text-align: right; color: #3498DB; font-weight: bold;'&gt;GPIO 2 (LED Azul Onboard) •&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23272D;strokeColor=#1A1D20;strokeWidth=2;fontColor=#ffffff;align=center;verticalAlign=top;spacingTop=8;">
          <mxGeometry x="520" y="160" width="280" height="290" as="geometry" />
        </mxCell>
        <mxCell id="sct_box" parent="1" vertex="1" value="&lt;b style='font-size: 13px;'&gt;Circuito 1: Medição de Corrente (SCT-013-000)&lt;/b&gt;&lt;hr style='border: 0.5px solid #6C8EBF;'&gt;&lt;div style='text-align: left; font-size: 11px; padding: 4px;'&gt;&lt;b&gt;1. Alicate SCT-013-000:&lt;/b&gt;&lt;br&gt;• Abraça 1 condutor (Fase) do cabo do ar.&lt;br&gt;• Termina em Jack P2 3.5mm:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ &lt;b&gt;Terminal A (Ponta):&lt;/b&gt; Sinal AC&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ &lt;b&gt;Terminal B (Manga):&lt;/b&gt; Retorno DC&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Resistor de Carga (Burden Rb):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Rb = 10 Ω a 33 Ω&lt;/b&gt; ligado direto entre Terminal A e Terminal B.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Divisor de Offset VBIAS (1,65 V):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;R1 (10 kΩ):&lt;/b&gt; Liga do 3.3V ao Nó VBIAS.&lt;br&gt;• &lt;b&gt;R2 (10 kΩ):&lt;/b&gt; Liga do Nó VBIAS ao GND.&lt;br&gt;• &lt;b&gt;C1 (10 µF):&lt;/b&gt; Polo (+) no VBIAS, (-) no GND.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Ligação no ESP32:&lt;/b&gt;&lt;br&gt;• Terminal B → Nó VBIAS (1,65V estável)&lt;br&gt;• Terminal A → &lt;b&gt;GPIO 34 (ADC1)&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=top;spacingTop=8;">
          <mxGeometry x="60" y="130" width="360" height="320" as="geometry" />
        </mxCell>
        <mxCell id="scd_box" parent="1" vertex="1" value="&lt;b style='font-size: 13px;'&gt;Circuito 2: Sensor de Ar (SCD40)&lt;/b&gt;&lt;hr style='border: 0.5px solid #82B366;'&gt;&lt;div style='text-align: left; font-size: 11px; padding: 4px;'&gt;&lt;b&gt;Sensor Fotoacústico (CO₂, Temp e Umid):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;VCC&lt;/b&gt; ──→ Conecta no pino &lt;b&gt;3V3&lt;/b&gt; do ESP32&lt;br&gt;• &lt;b&gt;GND&lt;/b&gt; ──→ Conecta no pino &lt;b&gt;GND&lt;/b&gt; do ESP32&lt;br&gt;• &lt;b&gt;SDA&lt;/b&gt; ──→ Conecta no pino &lt;b&gt;GPIO 21&lt;/b&gt; (Dados I2C)&lt;br&gt;• &lt;b&gt;SCL&lt;/b&gt; ──→ Conecta no pino &lt;b&gt;GPIO 22&lt;/b&gt; (Clock I2C)&lt;br&gt;&lt;br&gt;&lt;i&gt;* Apenas 4 jumpers diretos, sem resistores externos.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;align=center;verticalAlign=top;spacingTop=8;">
          <mxGeometry x="900" y="110" width="350" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ir_box" parent="1" vertex="1" value="&lt;b style='font-size: 13px;'&gt;Circuito 3: Emissor Infravermelho (IR 940nm)&lt;/b&gt;&lt;hr style='border: 0.5px solid #9673A6;'&gt;&lt;div style='text-align: left; font-size: 11px; padding: 4px;'&gt;&lt;b&gt;Controle do Split (Sem Transistor):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Pino GPIO 4&lt;/b&gt; ──→ Resistor &lt;b&gt;R_IR (100 Ω ou 220 Ω)&lt;/b&gt;&lt;br&gt;• Outro lado do resistor ──→ &lt;b&gt;Ânodo (+)&lt;/b&gt; do LED IR&lt;br&gt;• &lt;b&gt;Cátodo (-)&lt;/b&gt; do LED IR ──→ Conecta no &lt;b&gt;GND&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;* O ESP32 modula o sinal em 38 kHz diretamente.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;align=center;verticalAlign=top;spacingTop=8;">
          <mxGeometry x="900" y="300" width="350" height="160" as="geometry" />
        </mxCell>
        <mxCell id="leds_box" parent="1" vertex="1" value="&lt;b style='font-size: 13px;'&gt;Circuito 4: Sinalização Visual (LEDs de Diagnóstico)&lt;/b&gt;&lt;hr style='border: 0.5px solid #D6B656;'&gt;&lt;div style='text-align: left; font-size: 11px; padding: 4px;'&gt;• &lt;b&gt;LED Azul (Wi-Fi / Broker MQTT):&lt;/b&gt; Já está soldado na placa do ESP32 no &lt;b&gt;GPIO 2&lt;/b&gt; (zero fios extras!).&lt;br&gt;• &lt;b&gt;LED Amarelo (Heartbeat / Envio a cada 5s):&lt;/b&gt; &lt;b&gt;GPIO 18&lt;/b&gt; ──→ Resistor 220 Ω ──→ Ânodo (+) do LED ──→ Cátodo (-) no &lt;b&gt;GND&lt;/b&gt;.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=center;verticalAlign=top;spacingTop=8;">
          <mxGeometry x="520" y="490" width="550" height="110" as="geometry" />
        </mxCell>
        <mxCell id="edge_sct" parent="1" edge="1" source="sct_box" target="esp32" value="&lt;b&gt;Sinal AC Condicionado&lt;/b&gt;&lt;br&gt;Terminal A → GPIO 34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F1C40F;strokeWidth=2.5;fontSize=10;fontColor=#B7950B;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_scd" parent="1" edge="1" source="esp32" target="scd_box" value="&lt;b&gt;I2C (SDA 21 / SCL 22)&lt;/b&gt;&lt;br&gt;+ Alimentação (3V3 / GND)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2ECC71;strokeWidth=2.5;fontSize=10;fontColor=#1E8449;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_ir" parent="1" edge="1" source="esp32" target="ir_box" value="&lt;b&gt;PWM 38 kHz&lt;/b&gt;&lt;br&gt;GPIO 4 → R_IR → LED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9B59B6;strokeWidth=2.5;fontSize=10;fontColor=#6C3483;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>