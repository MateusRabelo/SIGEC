<mxfile host="app.diagrams.net" modified="2026-11-10T20:55:00.000Z" agent="SIGEC Diagram Generator" version="24.0.0" type="device">
  <diagram id="1._hardware_e_conexoes" name="1. Hardware e Conexoes">
    <mxGraphModel dx="1500" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="&lt;b style='font-size: 20px;'&gt;SIGEC — Esquema Completo de Ligações e Pinagem (ESP32)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 13px; color: #555555;'&gt;Detalhamento Fio a Fio: Divisor VBIAS, SCT-013, SCD40 (I2C), LED IR e Sinalização&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;">
          <mxGeometry x="380" y="20" width="640" height="50" as="geometry" />
        </mxCell>
        <mxCell id="esp32" parent="1" vertex="1" value="&lt;div style='font-size: 13px; font-weight: bold; padding: 4px;'&gt;ESP32 DevKit v1&lt;/div&gt;&lt;span style='font-size: 10px; color: #BDC3C7;'&gt;SoC Wi-Fi 2.4GHz + Dual-Core 240MHz&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;table style='font-size: 10px; width: 100%; border-collapse: collapse; text-align: left; padding: 2px;'&gt;&lt;tr style='border-bottom: 1px solid #444;'&gt;&lt;th style='color: #F1C40F;'&gt;Lado Esquerdo&lt;/th&gt;&lt;th style='text-align: right; color: #2ECC71;'&gt;Lado Direito&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='color: #888;'&gt;EN&lt;/td&gt;&lt;td style='text-align: right; color: #888;'&gt;GPIO 23&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='color: #888;'&gt;VP (GPIO 36)&lt;/td&gt;&lt;td style='text-align: right; color: #2ECC71; font-weight: bold;'&gt;GPIO 22 (SCL) •&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='color: #888;'&gt;VN (GPIO 39)&lt;/td&gt;&lt;td style='text-align: right; color: #888;'&gt;TX0 / RX0&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='color: #F1C40F; font-weight: bold;'&gt;• GPIO 34 (ADC1)&lt;/td&gt;&lt;td style='text-align: right; color: #2ECC71; font-weight: bold;'&gt;GPIO 21 (SDA) •&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='color: #888;'&gt;GPIO 35 .. 12&lt;/td&gt;&lt;td style='text-align: right; color: #888;'&gt;GPIO 19&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='color: #E67E22; font-weight: bold;'&gt;• 3V3 (Saída 3.3V)&lt;/td&gt;&lt;td style='text-align: right; color: #F39C12; font-weight: bold;'&gt;GPIO 18 (Heartbeat) •&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='color: #BDC3C7; font-weight: bold;'&gt;• GND (Terra)&lt;/td&gt;&lt;td style='text-align: right; color: #9B59B6; font-weight: bold;'&gt;GPIO 4 (LED IR) •&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='color: #E74C3C;'&gt;• VIN (USB 5V)&lt;/td&gt;&lt;td style='text-align: right; color: #3498DB; font-weight: bold;'&gt;GPIO 2 (LED Azul Onboard) •&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#23272D;strokeColor=#1A1D20;strokeWidth=2;fontColor=#ffffff;align=center;verticalAlign=top;spacingTop=8;">
          <mxGeometry x="520" y="160" width="280" height="290" as="geometry" />
        </mxCell>
        <mxCell id="sct_box" parent="1" vertex="1" value="&lt;b style='font-size: 13px;'&gt;Circuito 1: Medição de Corrente (SCT-013-000)&lt;/b&gt;&lt;hr style='border: 0.5px solid #6C8EBF;'&gt;&lt;div style='text-align: left; font-size: 11px; padding: 4px;'&gt;&lt;b&gt;1. Alicate SCT-013-000:&lt;/b&gt;&lt;br&gt;• Abraça 1 condutor (Fase) do cabo do ar.&lt;br&gt;• Termina em Jack P2 3.5mm:&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ &lt;b&gt;Terminal A (Ponta):&lt;/b&gt; Sinal AC&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;↳ &lt;b&gt;Terminal B (Manga):&lt;/b&gt; Retorno DC&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Resistor de Carga (Burden Rb):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Rb = 10 Ω a 33 Ω&lt;/b&gt; ligado direto entre Terminal A e Terminal B.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Divisor de Offset VBIAS (1,65 V):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;R1 (10 kΩ):&lt;/b&gt; Liga do 3.3V ao Nó VBIAS.&lt;br&gt;• &lt;b&gt;R2 (10 kΩ):&lt;/b&gt; Liga do Nó VBIAS ao GND.&lt;br&gt;• &lt;b&gt;C1 (10 µF):&lt;/b&gt; Polo (+) no VBIAS, (-) no GND.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Ligação no ESP32:&lt;/b&gt;&lt;br&gt;• Terminal B → Nó VBIAS (1,65V estável)&lt;br&gt;• Terminal A → &lt;b&gt;GPIO 34 (ADC1)&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=2;align=center;verticalAlign=top;spacingTop=8;">
          <mxGeometry x="60" y="130" width="360" height="320" as="geometry" />
        </mxCell>
        <mxCell id="scd_box" parent="1" vertex="1" value="&lt;b style='font-size: 13px;'&gt;Circuito 2: Sensor de Ar (SCD40)&lt;/b&gt;&lt;hr style='border: 0.5px solid #82B366;'&gt;&lt;div style='text-align: left; font-size: 11px; padding: 4px;'&gt;&lt;b&gt;Sensor Fotoacústico (CO₂, Temp e Umid):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;VCC&lt;/b&gt; ──→ Conecta no pino &lt;b&gt;3V3&lt;/b&gt; do ESP32&lt;br&gt;• &lt;b&gt;GND&lt;/b&gt; ──→ Conecta no pino &lt;b&gt;GND&lt;/b&gt; do ESP32&lt;br&gt;• &lt;b&gt;SDA&lt;/b&gt; ──→ Conecta no pino &lt;b&gt;GPIO 21&lt;/b&gt; (Dados I2C)&lt;br&gt;• &lt;b&gt;SCL&lt;/b&gt; ──→ Conecta no pino &lt;b&gt;GPIO 22&lt;/b&gt; (Clock I2C)&lt;br&gt;&lt;br&gt;&lt;i&gt;* Apenas 4 jumpers diretos, sem resistores externos.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=2;align=center;verticalAlign=top;spacingTop=8;">
          <mxGeometry x="900" y="110" width="350" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ir_box" parent="1" vertex="1" value="&lt;b style='font-size: 13px;'&gt;Circuito 3: Emissor Infravermelho (IR 940nm)&lt;/b&gt;&lt;hr style='border: 0.5px solid #9673A6;'&gt;&lt;div style='text-align: left; font-size: 11px; padding: 4px;'&gt;&lt;b&gt;Controle do Split (Sem Transistor):&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Pino GPIO 4&lt;/b&gt; ──→ Resistor &lt;b&gt;R_IR (100 Ω ou 220 Ω)&lt;/b&gt;&lt;br&gt;• Outro lado do resistor ──→ &lt;b&gt;Ânodo (+)&lt;/b&gt; do LED IR&lt;br&gt;• &lt;b&gt;Cátodo (-)&lt;/b&gt; do LED IR ──→ Conecta no &lt;b&gt;GND&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;* O ESP32 modula o sinal em 38 kHz diretamente.&lt;/i&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=2;align=center;verticalAlign=top;spacingTop=8;">
          <mxGeometry x="900" y="300" width="350" height="160" as="geometry" />
        </mxCell>
        <mxCell id="leds_box" parent="1" vertex="1" value="&lt;b style='font-size: 13px;'&gt;Circuito 4: Sinalização Visual (LEDs de Diagnóstico)&lt;/b&gt;&lt;hr style='border: 0.5px solid #D6B656;'&gt;&lt;div style='text-align: left; font-size: 11px; padding: 4px;'&gt;• &lt;b&gt;LED Azul (Wi-Fi / Broker MQTT):&lt;/b&gt; Já está soldado na placa do ESP32 no &lt;b&gt;GPIO 2&lt;/b&gt; (zero fios extras!).&lt;br&gt;• &lt;b&gt;LED Amarelo (Heartbeat / Envio a cada 5s):&lt;/b&gt; &lt;b&gt;GPIO 18&lt;/b&gt; ──→ Resistor 220 Ω ──→ Ânodo (+) do LED ──→ Cátodo (-) no &lt;b&gt;GND&lt;/b&gt;.&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;strokeWidth=2;align=center;verticalAlign=top;spacingTop=8;">
          <mxGeometry x="520" y="490" width="550" height="110" as="geometry" />
        </mxCell>
        <mxCell id="edge_sct" parent="1" edge="1" source="sct_box" target="esp32" value="&lt;b&gt;Sinal AC Condicionado&lt;/b&gt;&lt;br&gt;Terminal A → GPIO 34" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#F1C40F;strokeWidth=2.5;fontSize=10;fontColor=#B7950B;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_scd" parent="1" edge="1" source="esp32" target="scd_box" value="&lt;b&gt;I2C (SDA 21 / SCL 22)&lt;/b&gt;&lt;br&gt;+ Alimentação (3V3 / GND)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2ECC71;strokeWidth=2.5;fontSize=10;fontColor=#1E8449;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge_ir" parent="1" edge="1" source="esp32" target="ir_box" value="&lt;b&gt;PWM 38 kHz&lt;/b&gt;&lt;br&gt;GPIO 4 → R_IR → LED" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9B59B6;strokeWidth=2.5;fontSize=10;fontColor=#6C3483;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="2._arquitetura_do_sistema" name="2. Arquitetura do Sistema">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="&lt;b style='font-size: 18px;'&gt;SIGEC — Arquitetura de Software e Fluxo IoT de Ponta a Ponta&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 12px; color: #555555;'&gt;Camadas de Borda (Edge), Mensageria, Backend Assíncrono, Banco Relacional e Clientes&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;">
          <mxGeometry x="230" y="20" width="620" height="50" as="geometry" />
        </mxCell>
        <mxCell id="edge_box" parent="1" vertex="1" value="&lt;b&gt;1. Camada de Borda (ESP32)&lt;/b&gt;&lt;br&gt;&lt;hr style='border:0.5px solid #2980b9;'&gt;&lt;div style='text-align:left; font-size:10px; padding:4px;'&gt;• &lt;b&gt;Sensoriamento:&lt;/b&gt; SCD40 (CO2, Temp, Umid) + SCT-013 (Corrente AC)&lt;br&gt;• &lt;b&gt;Controle Local:&lt;/b&gt; Máquina de estados (faixas de CO2) + histerese 1°C&lt;br&gt;• &lt;b&gt;Atuação:&lt;/b&gt; IRremoteESP8266 (LED IR 940nm a 38 kHz)&lt;br&gt;• &lt;b&gt;Economia:&lt;/b&gt; Integração da potência ativa em R$ por ciclo&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;align=center;verticalAlign=top;spacingTop=6;">
          <mxGeometry x="40" y="160" width="230" height="160" as="geometry" />
        </mxCell>
        <mxCell id="mqtt_box" parent="1" vertex="1" value="&lt;b&gt;2. Mensageria MQTT&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;'&gt;Eclipse Mosquitto (Porta 1883)&lt;/span&gt;&lt;br&gt;&lt;hr style='border:0.5px solid #8e44ad;'&gt;&lt;div style='text-align:left; font-size:10px; padding:4px;'&gt;• &lt;b&gt;Tópico Telemetria:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;ufc/campus_russas/+/telemetry&lt;/code&gt;&lt;br&gt;• &lt;b&gt;Tópico Comandos:&lt;/b&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&lt;code&gt;ufc/campus_russas/{id}/commands&lt;/code&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;align=center;verticalAlign=top;spacingTop=6;">
          <mxGeometry x="330" y="160" width="210" height="160" as="geometry" />
        </mxCell>
        <mxCell id="backend_box" parent="1" vertex="1" value="&lt;b&gt;3. Backend Assíncrono (FastAPI)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;'&gt;Python 3.12 • uv • AsyncIO&lt;/span&gt;&lt;br&gt;&lt;hr style='border:0.5px solid #27ae60;'&gt;&lt;div style='text-align:left; font-size:10px; padding:4px;'&gt;• &lt;b&gt;MQTT Worker (aiomqtt):&lt;/b&gt; Ingestão contínua em background&lt;br&gt;• &lt;b&gt;Services Layer:&lt;/b&gt; Sala, Dispositivo, Telemetria, Comando&lt;br&gt;• &lt;b&gt;WebSocket Manager:&lt;/b&gt; Broadcast tempo real das salas&lt;br&gt;• &lt;b&gt;REST API Endpoints:&lt;/b&gt; /salas, /dispositivos, /telemetrias, /comandos&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;align=center;verticalAlign=top;spacingTop=6;">
          <mxGeometry x="600" y="140" width="250" height="200" as="geometry" />
        </mxCell>
        <mxCell id="db_box" parent="1" vertex="1" value="&lt;b&gt;4. Banco Relacional&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;'&gt;PostgreSQL 16 • SQLAlchemy Async&lt;/span&gt;&lt;br&gt;&lt;hr style='border:0.5px solid #d35400;'&gt;&lt;div style='text-align:left; font-size:10px; padding:4px;'&gt;• &lt;b&gt;Tabelas:&lt;/b&gt; salas, dispositivos, telemetrias, comandos&lt;br&gt;• &lt;b&gt;Migrations:&lt;/b&gt; Alembic (Single Head estrito)&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;align=center;verticalAlign=top;spacingTop=6;">
          <mxGeometry x="630" y="400" width="190" height="140" as="geometry" />
        </mxCell>
        <mxCell id="client_box" parent="1" vertex="1" value="&lt;b&gt;5. Camada de Apresentação&lt;/b&gt;&lt;br&gt;&lt;hr style='border:0.5px solid #f39c12;'&gt;&lt;div style='text-align:left; font-size:10px; padding:4px;'&gt;• &lt;b&gt;Painel Web:&lt;/b&gt; React / Vite + Tailwind + Recharts&lt;br&gt;• &lt;b&gt;App Mobile:&lt;/b&gt; Flutter / React Native&lt;br&gt;• &lt;b&gt;Visualização:&lt;/b&gt; Gráficos ao vivo, cards de R$ economizado, IAQ&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;align=center;verticalAlign=top;spacingTop=6;">
          <mxGeometry x="910" y="160" width="220" height="160" as="geometry" />
        </mxCell>
        <mxCell id="e_edge_mqtt" parent="1" edge="1" source="edge_box" target="mqtt_box" value="Pub Telemetria (JSON)&lt;br&gt;Sub Comandos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2980b9;strokeWidth=2;fontSize=9;fontColor=#1b4f72;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_mqtt_backend" parent="1" edge="1" source="mqtt_box" target="backend_box" value="Consumo aiomqtt&lt;br&gt;Envio de comandos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8e44ad;strokeWidth=2;fontSize=9;fontColor=#4a235a;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_backend_db" parent="1" edge="1" source="backend_box" target="db_box" value="Persistência Assíncrona&lt;br&gt;(asyncpg)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d35400;strokeWidth=2;fontSize=9;fontColor=#78281f;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_backend_client" parent="1" edge="1" source="backend_box" target="client_box" value="REST HTTP (JSON)&lt;br&gt;+ WebSocket (Tempo Real)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#27ae60;strokeWidth=2;fontSize=9;fontColor=#145a32;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="3._diagrama_de_classes_uml" name="3. Diagrama de Classes UML">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="&lt;b style='font-size: 18px;'&gt;SIGEC — Diagrama de Classes UML 2.5 (Modelo de Dados)&lt;/b&gt;&lt;br&gt;&lt;span style='font-size: 12px; color: #555555;'&gt;Entidades Relacionais implementadas no SQLAlchemy / PostgreSQL&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;">
          <mxGeometry x="260" y="20" width="540" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sala" parent="1" vertex="1" value="&lt;b&gt;SalaModel&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px; color:#555;'&gt;«table: salas»&lt;/span&gt;&lt;br&gt;&lt;hr style='border:0.5px solid #6c8ebf;'&gt;&lt;div style='text-align:left; font-size:10px; padding:3px;'&gt;- id: int [PK]&lt;br&gt;- numero: int&lt;br&gt;- unidade: int&lt;br&gt;- bloco: int&lt;br&gt;- potencial_base_kw: float = 2.5&lt;br&gt;- setpoint_atual: float = 24.0&lt;br&gt;- ativa: bool = True&lt;br&gt;- created_at: DateTime&lt;br&gt;- updated_at: DateTime&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=top;spacingTop=6;">
          <mxGeometry x="60" y="110" width="230" height="190" as="geometry" />
        </mxCell>
        <mxCell id="dispositivo" parent="1" vertex="1" value="&lt;b&gt;DispositivoModel&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px; color:#555;'&gt;«table: dispositivos»&lt;/span&gt;&lt;br&gt;&lt;hr style='border:0.5px solid #6c8ebf;'&gt;&lt;div style='text-align:left; font-size:10px; padding:3px;'&gt;- id: int [PK]&lt;br&gt;- sala_id: int [FK -&gt; salas.id]&lt;br&gt;- mac_address: string&lt;br&gt;- modelo_chip: string&lt;br&gt;- status: string = 'offline'&lt;br&gt;- last_seen: DateTime&lt;/div&gt;&lt;hr style='border:0.5px solid #6c8ebf;'&gt;&lt;div style='text-align:left; font-size:10px; padding:3px;'&gt;+ registrar_heartbeat(): void&lt;br&gt;+ isOnline(timeout: int = 60): bool&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=top;spacingTop=6;">
          <mxGeometry x="520" y="110" width="250" height="200" as="geometry" />
        </mxCell>
        <mxCell id="telemetria" parent="1" vertex="1" value="&lt;b&gt;TelemetriaModel&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px; color:#555;'&gt;«table: telemetrias»&lt;/span&gt;&lt;br&gt;&lt;hr style='border:0.5px solid #6c8ebf;'&gt;&lt;div style='text-align:left; font-size:10px; padding:3px;'&gt;- id: int [PK]&lt;br&gt;- sala_id: int [FK -&gt; salas.id]&lt;br&gt;- dispositivo_id: int [FK -&gt; dispositivos.id]&lt;br&gt;- co2: float&lt;br&gt;- temperatura: float&lt;br&gt;- umidade: float&lt;br&gt;- corrente_rms: float&lt;br&gt;- potencia_ativa_kw: float&lt;br&gt;- setpoint: float&lt;br&gt;- economia_ciclo_brl: float&lt;br&gt;- economia_acumulada_brl: float&lt;br&gt;- created_at: DateTime&lt;br&gt;- update_at: DateTime&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=1.5;align=center;verticalAlign=top;spacingTop=6;">
